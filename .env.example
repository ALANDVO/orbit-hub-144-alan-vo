# Orbit Hub Environment Configuration
# Copy to .env and fill in values

# Application
DEBUG=false
DEMO_MODE=false
SECRET_KEY=changemeinproductionmin32chars

# Database (SQLite for dev, PostgreSQL for production)
# For local dev: DATABASE_URL=sqlite+aiosqlite:///./orbit.db
# For Docker: DATABASE_URL=postgresql+asyncpg://orbithub:password@postgres:5432/orbithub
DATABASE_URL=sqlite+aiosqlite:///./orbit.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keycloak / OIDC Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=orbithub
KEYCLOAK_CLIENT_ID=orbithub-frontend
KEYCLOAK_CLIENT_SECRET=
OIDC_ISSUER_URL=http://localhost:8080/realms/orbithub
OIDC_AUDIENCE=orbithub-frontend

# LLM Configuration (server-side only, never exposed to frontend)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=

# PostgreSQL (for Docker compose)
POSTGRES_PASSWORD=changeme
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_CLIENT_SECRET=changeme